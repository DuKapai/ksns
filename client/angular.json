{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ksnk-demo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ksnk-demo",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob":"**/*","input":"src/assets","output":"assets"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {"budgets":[{"type":"initial","maximumWarning":"1.5MB","maximumError":"3MB"}],"outputHashing":"all"},
            "development": {"optimization":false,"extractLicenses":false,"sourceMap":true},
            "pages": {"browser":"src/main-pages.ts","index":{"input":"src/index-pages.html","output":"index.html"},"tsConfig":"tsconfig.pages.json"}
          },
          "defaultConfiguration": "production"
        },
        "serve": {"builder":"@angular/build:dev-server","configurations":{"production":{"buildTarget":"ksnk-demo:build:production"},"development":{"buildTarget":"ksnk-demo:build:development"}},"defaultConfiguration":"development"}
      }
    }
  },
  "cli": {
    "analytics": "02009cc6-200c-4417-976d-325561157028"
  }
}
