# Chế độ demo: không gọi hệ thống bệnh viện.
PORT=3000
CLIENT_ORIGIN=http://localhost:4200
AUTH_MODE=demo
# Để dùng xác thực bệnh viện: AUTH_MODE=hospital và cấu hình endpoint được phê duyệt.
# HIS_API_BASE_URL=https://replace-with-approved-api-host
# HIS_AUTH_PROTOCOL=employee-cookie-api
# Phiên MyHV dùng cookie irw_session và HIS_SESSION_PATH=/api/me.
# Trình duyệt phải gửi được cookie tới API KSNK (cùng host/cấu hình proxy).
# Các quyền phải được quản trị viên phê duyệt; ví dụ định dạng:
# HIS_ROLE_ASSIGNMENTS={"MA_BAC_SI":{"roles":["MEMBER_DOCTOR"]},"MA_KSNK":{"roles":["KSNK_ADMIN"]}}
# Thành viên phải được đăng ký, kích hoạt trong danh sách mạng lưới.
# Chế độ bệnh viện yêu cầu DATA_FILE riêng đã tồn tại và JWT_SECRET ngẫu nhiên.
# Kho JSON hiện tại chỉ hỗ trợ một tiến trình; cần giải pháp lưu trữ an toàn
# và xác minh tích hợp thực tế trước khi dùng dữ liệu bệnh nhân.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
DATA_FILE=./data/demo-store.json
